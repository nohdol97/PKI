{"id": "mail-0039", "source_type": "mail", "external_id": "<s11-i2-mailC@mail.example.test>", "title": "알림판 개편 배포", "content": "알림판 공지 영역 개편은 2026-12-02에 배포합니다.\n", "author": "gaeun.shin@example.test", "participants": ["gaeun.shin@example.test"], "thread_id": "thr-s11-i2-mailC", "source_url": "https://mail.example.test/msg/s11-i2-mailC", "created_at": "2026-11-17T10:00:00+09:00", "updated_at": "2026-11-17T10:00:00+09:00", "content_hash": "sha256:5034c76dc6aaad656134a3b01546d2353a35dcc87b2ef92566d225296785e929", "version": 1, "access_scope": ["org:all"], "metadata": {}, "connector_instance_id": "conn-mail-01", "operation": "upsert", "schema_version": "1"}
