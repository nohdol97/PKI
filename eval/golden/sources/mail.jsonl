{"id": "mail-0021", "source_type": "mail", "external_id": "<s06-i2-mailC@mail.example.test>", "title": "전환 훈련 결과", "content": "우회 경로 B 전환 훈련 결과를 공유합니다. 전환에는 평균 4분이 걸렸습니다.\n", "author": "yeonwoo.kang@example.test", "participants": ["yeonwoo.kang@example.test"], "thread_id": "thr-s06-i2-mailC", "source_url": "https://mail.example.test/msg/s06-i2-mailC", "created_at": "2026-10-25T17:00:00+09:00", "updated_at": "2026-10-25T17:00:00+09:00", "content_hash": "sha256:0c1f4c2ee0e907c60680cb031d6bba8ac6357f4453f650591ab93cda6e72d5d3", "version": 1, "access_scope": ["org:all"], "metadata": {}, "connector_instance_id": "conn-mail-01", "operation": "upsert", "schema_version": "1"}
